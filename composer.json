{
    "name": "tomvondracek/bolt-llms-txt",
    "description": "Bolt CMS extension that serves a dynamic /llms.txt (llmstxt.org), rendered from your own Twig template with HTTP caching, ETag and HTML-to-Markdown filters built in.",
    "type": "bolt-extension",
    "license": "MIT",
    "keywords": ["bolt", "bolt-extension", "llms-txt", "llm", "ai", "seo", "twig"],
    "authors": [
        {
            "name": "Tomáš Vondráček",
            "email": "tomasvondrac@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "symfony/polyfill-php84": "^1.43.0",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "bolt/core": "^6.1.10",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.3.4",
        "phpstan/phpstan-deprecation-rules": "2.0.5",
        "phpunit/phpunit": "^11.5.57",
        "rector/rector": "2.8.3",
        "symplify/easy-coding-standard": "^13.3.12",
        "phpstan/phpstan-phpunit": "2.1.1",
        "phpstan/phpstan-strict-rules": "2.1.0"
    },
    "conflict": {
        "bolt/core": "<6.0 || >=7.0"
    },
    "autoload": {
        "psr-4": {
            "Tomvondracek\\LlmsTxt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tomvondracek\\LlmsTxt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        },
        "entrypoint": "Tomvondracek\\LlmsTxt\\Extension"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "drupol/composer-packages": false,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        }
    }
}
